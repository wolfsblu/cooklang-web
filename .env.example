# Copy to .env and fill in. Used by docker-compose.yml.

# Container image tag. Pin a release (for example 1.2.3) for a reproducible
# deployment. `latest` follows the newest tagged release; `main` is the
# unstable tip. Version tags are immutable; see docs/RELEASING.md.
COOKLANG_WEB_VERSION=latest

# Where the recipe library lives on the host. This is the NAS mount.
RECIPES_HOST_PATH=/volume1/recipes

# Port Caddy listens on.
HTTP_PORT=8080

# Public URL of the app, e.g. http://nas.local:8080. Optional behind the
# bundled Caddy, which forwards the headers the app needs. Set it if you put a
# different proxy in front, or form submissions will be rejected as cross-site.
PUBLIC_ORIGIN=

# imgproxy URL signing. Both must be hex, and both must be set or the app
# falls back to serving original images itself.
#
#   openssl rand -hex 32
IMGPROXY_KEY=
IMGPROXY_SALT=

# ---------------------------------------------------------------------------
# AI recipe import (optional). Any OpenAI-compatible /chat/completions
# provider works; the defaults point at DeepSeek. URL import is disabled until
# AI_API_KEY is set; photo import until AI_VISION_MODEL is set.
# ---------------------------------------------------------------------------

# DeepSeek API key, e.g. sk-...
AI_API_KEY=
# AI_BASE_URL=https://api.deepseek.com
# AI_MODEL=deepseek-chat
# AI_TIMEOUT_MS=90000
# AI_MAX_TOKENS=4096

# Photo import needs a vision-capable model. Leave AI_VISION_MODEL empty to
# disable it (the default text model cannot read images). The base URL and key
# fall back to AI_BASE_URL and AI_API_KEY, so a single provider can serve both.
# AI_VISION_MODEL=gpt-4o-mini
# AI_VISION_BASE_URL=https://api.openai.com/v1
# AI_VISION_API_KEY=sk-...

# ---------------------------------------------------------------------------
# Read directly by the app; only needed when running it outside compose.
# ---------------------------------------------------------------------------

# RECIPE_PATH=./recipes
# COOK_CLI_PATH=cook
# COOK_CLI_TIMEOUT=30000

# How long the recipe index serves results before re-stat'ing the recipe
# directory. 0 in development so edits appear immediately.
# RECIPE_INDEX_TTL_MS=30000

# Largest request body accepted by the Node server. The image is set to 25M in
# the Dockerfile so cover-image uploads (up to 20 MB) get through; lower it only
# if you also lower the upload limit.
# BODY_SIZE_LIMIT=25M
